{
  "name": "tiptap-essentials",
  "version": "2.0.0-beta.5",
  "description": "Essential extensions of Tiptap",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./samples": {
      "types": "./dist/samples.d.ts",
      "default": "./dist/samples.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc",
    "test": "vitest run",
    "prepack": "npm run build",
    "prepublishOnly": "npm test",
    "write-samples": "npm run build && node scripts/write-samples.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/musaffa/tiptap-essentials.git"
  },
  "peerDependencies": {
    "@tiptap/core": "^3.35.0",
    "@tiptap/pm": "^3.35.0"
  },
  "dependencies": {
    "@tiptap/extension-highlight": "^3.35.0",
    "@tiptap/extension-image": "^3.35.0",
    "@tiptap/extension-subscript": "^3.35.0",
    "@tiptap/extension-superscript": "^3.35.0",
    "@tiptap/extension-table": "^3.35.0",
    "@tiptap/extension-text-align": "^3.35.0",
    "@tiptap/extension-text-style": "^3.35.0",
    "@tiptap/extension-youtube": "^3.35.0",
    "@tiptap/starter-kit": "^3.35.0"
  },
  "devDependencies": {
    "@tiptap/core": "3.35.0",
    "@tiptap/pm": "3.35.0",
    "happy-dom": "^21.0.4",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  },
  "author": "Ahmad Musaffa",
  "license": "MIT"
}
